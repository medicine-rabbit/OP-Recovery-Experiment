{
	"nodes":[
		{"id":"c846f8b60798a49b","type":"text","text":"Envelope Run + Aerobic Strides\n\nTake average pace from each 1 km split of the envelope run to set the target pace in the subsequent pace hold run.\n\nFocus on extracting more speed out of the power setting by improving running form.","x":-540,"y":130,"width":250,"height":370,"color":"4"},
		{"id":"30db2d3f3d9610b3","type":"text","text":"Pace Hold (Long Run)\n\nFasted\n\nShould be able to perform a long run at the target pace where HR drifts from zone 2 to the top of zone 3.","x":-20,"y":185,"width":250,"height":261,"color":"4"},
		{"id":"d42380fedd9eb5cd","type":"text","text":"[AUTOPHAGY+]","x":440,"y":285,"width":250,"height":60,"color":"1"},
		{"id":"88454ed8a08faacc","type":"text","text":"MAF + Stride Test\n\nDerive power settings for envelope run + aerobic strides.","x":-1200,"y":186,"width":250,"height":260,"color":"3"},
